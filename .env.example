# copiar pra .env, não subir no git

EFFORT_URL=https://huusp.globalthings.net

# usuário só pro painel, senão derruba a sessão de alguém
EFFORT_USUARIO=
EFFORT_SENHA=

EFFORT_LIBERAR_ACESSO=true

EFFORT_EMPRESA=Manutenção de Equipamentos

# dias úteis 7h e 13h
AGENDA_CRON=0 7,13 * * 1-5

# vazio = sem senha
SENHA_PAINEL=

# false pra ver o navegador
HEADLESS=true
