# Copie para .env e preencha. NUNCA suba o .env para o Git.

# Endereço do Effort do hospital
EFFORT_URL=https://huusp.globalthings.net

# Usuário DEDICADO ao painel (peça à TI/administração do Effort um usuário só de leitura).
# O Effort só permite uma sessão por usuário: com o usuário de uma pessoa, a coleta derruba a sessão dela.
EFFORT_USUARIO=
EFFORT_SENHA=

# Se já houver sessão aberta com este usuário, clicar em "Liberar Acesso" automaticamente.
EFFORT_LIBERAR_ACESSO=true

# Empresa escolhida na tela "Escolher empresa" logo após o login (o texto como aparece no Effort).
EFFORT_EMPRESA=Manutenção de Equipamentos

# Horários das coletas automáticas (cron, horário de Brasília). Padrão: dias úteis às 7h e às 13h.
AGENDA_CRON=0 7,13 * * 1-5

# Senha simples para abrir o painel (opcional; deixe vazio se ele já estiver só na rede interna).
SENHA_PAINEL=

# Mostrar o navegador durante a coleta (útil só para depurar no seu computador)
HEADLESS=true
